rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isChanging(key) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([key]);
    }

    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || request.auth.uid == adminId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !isChanging('role')
                    && !isChanging('admin');

      allow update: if isAdmin()
                    && !isChanging('role')
                    && !isChanging('admin')
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status']);

      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /rides/{rideId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'cancelledBy', 'cancelledAt']);
      allow delete: if isAdmin();
    }

    match /rideRequests/{requestId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status']);
      allow delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /adminAuditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
